{
  "name": "vendor-dashboard",
  "version": "2.3.1",
  "description": "Monitors the live status of a configurable SaaS vendor set by polling each vendor's public status endpoint. Cloudflare Worker + runtime-agnostic engine.",
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint .",
    "test:coverage": "vitest run --coverage",
    "test:mutation": "stryker run",
    "perf": "node scripts/perf-check.mjs",
    "deploy": "bash scripts/deploy.sh"
  },
  "keywords": [
    "cloudflare-workers",
    "status-monitoring",
    "statuspage",
    "vendor-status",
    "d1",
    "observability"
  ],
  "author": "Brian Greenberg (https://briangreenberg.net)",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bjgreenberg/vendor-dashboard.git"
  },
  "bugs": {
    "url": "https://github.com/bjgreenberg/vendor-dashboard/issues"
  },
  "homepage": "https://github.com/bjgreenberg/vendor-dashboard#readme",
  "type": "module",
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@stryker-mutator/core": "^10.0.0",
    "@stryker-mutator/vitest-runner": "^9.6.1",
    "@vitest/coverage-v8": "^4.1.10",
    "axe-core": "^4.13.0",
    "eslint": "^10.9.0",
    "fast-check": "^4.9.0",
    "globals": "^17.11.0",
    "jsdom": "^30.0.1",
    "vitest": "^4.1.10",
    "wrangler": "4.125.0"
  },
  "overrides": {
    "jsdom": {
      "undici": "^8.10.0"
    },
    "wrangler": {
      "undici": "^7.29.0"
    },
    "miniflare": {
      "undici": "^7.29.0"
    }
  }
}
